datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}
model User {
  id                 String   @id @default(cuid())
  email              String   @unique
  password           String
  name               String?
  role               String   @default("user")
  onboardingCompleted Boolean @default(false)
  onboardingData     Json?
  audienceRole       String?
  location           String?
  workspaceMode      String?
  pricingRecommendation String?

  tier               String    @default("free")
  subscriptionStatus String    @default("inactive")
  subscriptionType   String    @default("none")
  subscriptionId     String?
  stripeCustomerId   String?
  currentPeriodEnd   DateTime?
  provider           String?

  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  drafts    Draft[]
  sessions  Session[]
  clientFolders ClientFolder[]
  clientPermissions ClientPermission[]
  clientActivityLogs ClientActivityLog[]
  clientTemplates ClientTemplate[]
  checkmateReports CheckmateReport[]
  clientDocuments ClientDocument[]

  @@index([createdAt])
  @@index([tier])
}

model Session {
  token     String   @id
  email     String
  createdAt DateTime @default(now())
  expiresAt DateTime
  user      User     @relation(fields: [email], references: [email])
}

model Draft {
  id              String   @id @default(uuid())
  userId          String
  clientId        String?
  title           String
  content         String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  tierAtCreation  String
  user            User     @relation(fields: [userId], references: [id])
  client          ClientFolder? @relation(fields: [clientId], references: [id], onDelete: SetNull)
  versions        DraftVersion[]
  checkmateReports CheckmateReport[]

  @@index([clientId])
  @@index([userId, updatedAt])
}

model ClientFolder {
  id          String   @id @default(cuid())
  ownerId     String
  name        String
  sector      String?
  state       String?
  funders     Json?
  notes       String?
  brandLogoUrl String?
  brandColor  String?
  contactInfo String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  owner       User @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  drafts      Draft[]
  permissions ClientPermission[]
  activityLogs ClientActivityLog[]
  templates   ClientTemplate[]
  reports     CheckmateReport[]
  documents   ClientDocument[]

  @@index([ownerId])
  @@index([state])
  @@index([sector])
}

model ClientPermission {
  id        String   @id @default(cuid())
  clientId  String
  userId    String?
  email     String?
  role      String   @default("viewer")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  client    ClientFolder @relation(fields: [clientId], references: [id], onDelete: Cascade)
  user      User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([clientId])
  @@index([userId])
  @@index([email])
}

model ClientActivityLog {
  id        String   @id @default(cuid())
  clientId  String
  userId    String?
  action    String
  detail    String?
  metadata  Json?
  createdAt DateTime @default(now())

  client    ClientFolder @relation(fields: [clientId], references: [id], onDelete: Cascade)
  user      User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([clientId, createdAt])
  @@index([userId])
}

model ClientTemplate {
  id        String   @id @default(cuid())
  clientId  String
  userId    String
  type      String
  title     String
  content   String
  isShared  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  client    ClientFolder @relation(fields: [clientId], references: [id], onDelete: Cascade)
  user      User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([clientId])
  @@index([userId])
  @@index([type])
}

model CheckmateReport {
  id        String   @id @default(cuid())
  clientId  String
  draftId   String?
  userId    String
  title     String
  score     Int
  strengths Json
  weaknesses Json
  missingComponents Json
  complianceIssues Json
  recommendedFixes Json
  funderAlignment Json
  exportedAs String?
  createdAt DateTime @default(now())

  client    ClientFolder @relation(fields: [clientId], references: [id], onDelete: Cascade)
  draft     Draft? @relation(fields: [draftId], references: [id], onDelete: SetNull)
  user      User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([clientId, createdAt])
  @@index([draftId])
  @@index([userId])
}

model ClientDocument {
  id        String   @id @default(cuid())
  clientId  String
  userId    String
  name      String
  type      String?
  url       String?
  notes     String?
  createdAt DateTime @default(now())

  client    ClientFolder @relation(fields: [clientId], references: [id], onDelete: Cascade)
  user      User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([clientId])
  @@index([userId])
}

model Invite {
  id         String   @id @default(uuid())
  email      String
  inviterId  String
  tier       String
  status     String   // "pending" | "accepted" | "cancelled"
  sentAt     DateTime
  acceptedAt DateTime?
}

model DraftVersion {
  id        String   @id @default(cuid())
  draftId   String
  content   String
  createdAt DateTime @default(now())

  draft     Draft    @relation(fields: [draftId], references: [id])
}

model AiLog {
  id        String   @id @default(cuid())
  userId    String?
  action    String   // "generate" | "improve" | "template" | "score"
  createdAt DateTime @default(now())

  @@index([action])
  @@index([createdAt])
  @@index([userId])
}

model ErrorLog {
  id        String   @id @default(cuid())
  message   String
  endpoint String?
  userId   String?
  severity String   @default("info") // "critical" | "warning" | "info"
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([severity])
}

model LifetimeTier {
  id        String   @id @default(cuid())
  userId    String?
  claimed   Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([claimed])
}
