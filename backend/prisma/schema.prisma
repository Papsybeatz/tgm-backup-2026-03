datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}
model User {
  id                 String   @id @default(cuid())
  email              String   @unique
  password           String
  name               String?
  role               String   @default("user")

  tier               String    @default("free")
  subscriptionStatus String    @default("inactive")
  subscriptionType   String    @default("none")
  subscriptionId     String?
  stripeCustomerId   String?
  currentPeriodEnd   DateTime?
  provider           String?

  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  drafts    Draft[]
  sessions  Session[]
  clientFolders ClientFolder[]
  clientPermissions ClientPermission[]
  clientActivityLogs ClientActivityLog[]
  clientTemplates ClientTemplate[]
  checkmateReports CheckmateReport[]
  clientDocuments ClientDocument[]

  @@index([createdAt])
  @@index([tier])
}

model Session {
  token     String   @id
  email     String
  createdAt DateTime @default(now())
  expiresAt DateTime
  user      User     @relation(fields: [email], references: [email])
}

model Draft {
  id              String   @id @default(uuid())
  userId          String
  title           String
  content         String
  // The order ticket Steve took for this draft. Checkmate needs it to judge
  // funder alignment and completeness; without it a saved draft could only be
  // scored by a cruder heuristic.
  order           Json?
  // Which client this draft belongs to, when a consultant produced it.
  clientId        String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  tierAtCreation  String
  user            User     @relation(fields: [userId], references: [id])
  versions        DraftVersion[]
  checkmateReports CheckmateReport[]

  @@index([userId, updatedAt])
  @@index([clientId])
}

model ClientFolder {
  id          String   @id @default(cuid())
  ownerId     String
  name        String
  sector      String?
  state       String?
  funders     Json?
  notes       String?
  brandLogoUrl String?
  brandColor  String?
  contactInfo String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  owner       User @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  permissions ClientPermission[]
  activityLogs ClientActivityLog[]
  templates   ClientTemplate[]
  reports     CheckmateReport[]
  documents   ClientDocument[]

  @@index([ownerId])
  @@index([state])
  @@index([sector])
}

model ClientPermission {
  id        String   @id @default(cuid())
  clientId  String
  userId    String?
  email     String?
  role      String   @default("viewer")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  client    ClientFolder @relation(fields: [clientId], references: [id], onDelete: Cascade)
  user      User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([clientId])
  @@index([userId])
  @@index([email])
}

model ClientActivityLog {
  id        String   @id @default(cuid())
  clientId  String
  userId    String?
  action    String
  detail    String?
  metadata  Json?
  createdAt DateTime @default(now())

  client    ClientFolder @relation(fields: [clientId], references: [id], onDelete: Cascade)
  user      User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([clientId, createdAt])
  @@index([userId])
}

model ClientTemplate {
  id        String   @id @default(cuid())
  clientId  String
  userId    String
  type      String
  title     String
  content   String
  isShared  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  client    ClientFolder @relation(fields: [clientId], references: [id], onDelete: Cascade)
  user      User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([clientId])
  @@index([userId])
  @@index([type])
}

model CheckmateReport {
  id        String   @id @default(cuid())
  clientId  String
  draftId   String?
  userId    String
  title     String
  score     Int
  strengths Json
  weaknesses Json
  missingComponents Json
  complianceIssues Json
  recommendedFixes Json
  funderAlignment Json
  exportedAs String?
  createdAt DateTime @default(now())

  client    ClientFolder @relation(fields: [clientId], references: [id], onDelete: Cascade)
  draft     Draft? @relation(fields: [draftId], references: [id], onDelete: SetNull)
  user      User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([clientId, createdAt])
  @@index([draftId])
  @@index([userId])
}

model ClientDocument {
  id        String   @id @default(cuid())
  clientId  String
  userId    String
  name      String
  type      String?
  url       String?
  notes     String?
  createdAt DateTime @default(now())

  client    ClientFolder @relation(fields: [clientId], references: [id], onDelete: Cascade)
  user      User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([clientId])
  @@index([userId])
}

model Invite {
  id         String   @id @default(uuid())
  email      String
  inviterId  String
  tier       String
  status     String   // "pending" | "accepted" | "cancelled"
  sentAt     DateTime
  acceptedAt DateTime?
}

// Public waitlist: someone who is not yet a customer asking for access.
//
// This is deliberately NOT the Invite table. An Invite is a seat handed out by
// an existing customer to a named address, and it carries an inviterId and a
// tier that the invitee inherits. A request has no inviter and grants nothing —
// it is just a lead. Conflating them would put unvetted strangers in the same
// table as granted seats.
//
// It replaces a JSON file under backend/data/, which was lost on every Railway
// redeploy (the filesystem is ephemeral), so the waitlist never survived a
// deploy. Email is unique so a repeat submission is idempotent rather than a
// duplicate row.
model InviteRequest {
  id           String   @id @default(cuid())
  name         String?
  email        String   @unique
  organization String?
  reason       String?
  tier         String? // which plan they asked about, when the caller knows
  status       String   @default("pending") // "pending" | "approved" | "denied"
  createdAt    DateTime @default(now())

  @@index([status, createdAt])
}

model DraftVersion {
  id        String   @id @default(cuid())
  draftId   String
  content   String
  createdAt DateTime @default(now())

  draft     Draft    @relation(fields: [draftId], references: [id])
}

model AiLog {
  id        String   @id @default(cuid())
  userId    String?
  action    String   // "generate" | "improve" | "template" | "score"
  createdAt DateTime @default(now())

  @@index([action])
  @@index([createdAt])
  @@index([userId])
}

model ErrorLog {
  id          String   @id @default(cuid())
  createdAt   DateTime @default(now())
  severity    String   @default("error") // "critical" | "error" | "warning" | "info"
  source      String?  // "http" | "app" | "ai" | "webhook" | "process"
  message     String
  stack       String?
  status      Int?     // HTTP status, when the failure came from a request
  method      String?
  path        String?
  endpoint    String?  // kept for the older callers
  userId      String?
  userEmail   String?
  tier        String?  // the column that answers "which plan broke?"
  requestId   String?
  meta        Json?    // redacted context only — never secrets or payloads
  fingerprint String?  // hash of path+status+message, for grouping and alert throttling

  @@index([createdAt])
  @@index([severity])
  @@index([userId])
  @@index([fingerprint, createdAt])
}

model LifetimeTier {
  id        String   @id @default(cuid())
  userId    String?
  claimed   Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([claimed])
}

// ---------------------------------------------------------------------------
// Steve — conversational grant concierge
// ---------------------------------------------------------------------------

model AssistantSession {
  id          String   @id @default(cuid())
  userId      String
  // Set when a consultant is working inside a client folder. Sessions are
  // scoped per client so switching clients never carries a conversation across.
  clientId    String?
  status      String   @default("intake") // intake | drafting | ready_for_review | delivered
  order       Json
  draftId     String?
  docTitle    String?
  docHtml     String?
  style       String   @default("full_proposal")
  score       Int?
  scoreReport Json?
  lastIntent  String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  messages AssistantMessage[]

  @@index([userId, updatedAt])
  @@index([userId, clientId])
  @@index([draftId])
}

model AssistantMessage {
  id        String   @id @default(cuid())
  sessionId String
  role      String // user | assistant | tool
  content   String
  metadata  Json?
  createdAt DateTime @default(now())

  session AssistantSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId, createdAt])
}


/// A testimonial submitted by a real user. Anonymous by design: the quote is
/// genuine and the attribution names a role, an org type and a region rather
/// than a person — anonymity hides *who* said it, never *whether* someone did.
/// Rows land as "pending" and are only ever shown once an admin approves them.
model Testimonial {
  id        String   @id @default(cuid())
  quote     String
  role      String?
  orgType   String?
  region    String?
  email     String?
  status    String   @default("pending")
  source    String   @default("website")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([createdAt])
}
