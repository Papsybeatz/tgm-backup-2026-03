# TGM Funder Intelligence API — Environment Variables
# Copy these into your Railway service environment dashboard.

# ─────────────────────────────────────────────────────────────────────────
# REQUIRED — Railway injects PORT automatically. Do NOT set this manually.
# Railway will provide its own PORT value.
# ─────────────────────────────────────────────────────────────────────────
# PORT=4500

# ─────────────────────────────────────────────────────────────────────────
# OPTIONAL — Local override port (only used when PORT is not set by Railway)
# ─────────────────────────────────────────────────────────────────────────
FUNDER_INTELLIGENCE_PORT=4500

# ─────────────────────────────────────────────────────────────────────────
# NODE_ENV — Set to "production" in Railway dashboard
# ─────────────────────────────────────────────────────────────────────────
NODE_ENV=production
