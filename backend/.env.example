# TGM Backend — Railway environment variables
# Railway injects PORT automatically. Do not set it manually.

# Brevo
# Request BREVO_API_KEY directly and paste it into the Railway backend service.
BREVO_API_KEY=
BREVO_FROM_EMAIL=support@thegrantsmaster.com
BREVO_FROM_NAME=The Grants Master

# Recommended route:
# Use a dedicated Brevo list for funder API leads so they are separated
# from generic lead magnet and signup audiences.
BREVO_FUNDER_LIST_ID=

# Optional fallback for older/shared flows.
# Only use this if you intentionally want funder API leads to land in the
# same list as your general Brevo automations.
BREVO_LIST_ID=

# Runtime
NODE_ENV=production

# App URL (used in emails and checkout redirect URLs)
APP_URL=https://www.thegrantsmaster.com

# Admin email for internal alerts
ADMIN_EMAIL=

# Stripe (core app pricing)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_STARTER_PRICE_ID=
STRIPE_PRO_PRICE_ID=
STRIPE_ANNUAL_PRO_PRICE_ID=
STRIPE_AGENCY_STARTER_PRICE_ID=
STRIPE_AGENCY_UNLIMITED_PRICE_ID=
STRIPE_LIFETIME_PRICE_ID=

# Stripe (funder intelligence pricing — one-time payment per cycle)
STRIPE_FUNDER_PILOT_PRICE_ID=
STRIPE_FUNDER_SCALE_PRICE_ID=
STRIPE_FUNDER_ENTERPRISE_PRICE_ID=

# Funder Intelligence API sidecar
# URL of the deployed sidecar service (e.g. https://funder-intelligence-api.up.railway.app)
FUNDER_INTELLIGENCE_BASE_URL=

# Shared secret between main backend and sidecar for internal-only provisioning routes.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Must be set on BOTH the main backend service AND the sidecar service.
FUNDER_INTELLIGENCE_INTERNAL_SECRET=

# Default application quotas per cycle (sidecar uses these for new entitlements)
# Pilot: 50 applications/cycle | Scale: 500 applications/cycle
FUNDER_PILOT_CYCLE_APPLICATIONS=50
FUNDER_SCALE_CYCLE_APPLICATIONS=500

# Cloudflare Turnstile (optional — add to harden intake form against bots)
# Set site key in frontend env; set secret key here in backend
TURNSTILE_SECRET_KEY=
