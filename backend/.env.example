# TGM Backend — Railway environment variables
# Railway injects PORT automatically. Do not set it manually.

# Brevo
# Request BREVO_API_KEY directly and paste it into the Railway backend service.
BREVO_API_KEY=
BREVO_FROM_EMAIL=support@thegrantsmaster.com
BREVO_FROM_NAME=The Grants Master

# Recommended route:
# Use a dedicated Brevo list for funder API leads so they are separated
# from generic lead magnet and signup audiences.
BREVO_FUNDER_LIST_ID=

# Optional fallback for older/shared flows.
# Only use this if you intentionally want funder API leads to land in the
# same list as your general Brevo automations.
BREVO_LIST_ID=

# Runtime
NODE_ENV=production

# Stripe (core app pricing)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_STARTER_PRICE_ID=
STRIPE_PRO_PRICE_ID=
STRIPE_ANNUAL_PRO_PRICE_ID=
STRIPE_AGENCY_STARTER_PRICE_ID=
STRIPE_AGENCY_UNLIMITED_PRICE_ID=
STRIPE_LIFETIME_PRICE_ID=

# Stripe (funder intelligence pricing)
STRIPE_FUNDER_PILOT_PRICE_ID=
STRIPE_FUNDER_SCALE_PRICE_ID=
STRIPE_FUNDER_ENTERPRISE_PRICE_ID=
